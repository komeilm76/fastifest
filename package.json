{
  "name": "fastifest",
  "version": "0.1.0",
  "description": "Generate Web App Manifest files and standardized icons and screenshots from project assets.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fastifest": "./dist/cli.js"
  },
  "files": [
    "dist/**",
    "docs/user/**",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "package:check": "node scripts/verify-package-contents.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
